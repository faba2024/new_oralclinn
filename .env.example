# ============================================================
# Oralclin — variáveis de ambiente
# Local: copie este arquivo para .env.local e preencha.
# Vercel: Project → Settings → Environment Variables.
# ============================================================

# --- Acesso ao painel (/admin/login) -------------------------
# Segredo usado para assinar o cookie de sessão. Obrigatório em produção.
# Gere com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Primeiro administrador. É criado automaticamente no primeiro login
# (a senha é guardada somente como hash no banco).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# Recuperação de acesso: com "true", a senha do ADMIN_EMAIL volta a ser
# ADMIN_PASSWORD no próximo login. Depois, volte para "false".
ADMIN_RESET_PASSWORD=false

# --- Banco de dados ------------------------------------------
# Produção (Vercel): conecte o Upstash Redis em Storage → Upstash for Redis.
# A Vercel cria estas variáveis automaticamente.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (também aceitos: UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN)

# Local: sem Redis, os dados ficam em .data/oralclin-db.json.

# Dados de demonstração (pacientes, agenda, financeiro fictícios) na
# primeira inicialização do banco. Use "false" para começar vazio.
SEED_DEMO_DATA=true

# Prefixo das chaves no Redis (opcional; útil para separar ambientes).
DATA_PREFIX=oralclin

# --- Site ----------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://oralclin.com.br
NEXT_PUBLIC_CLINIC_TIMEZONE=America/Sao_Paulo
